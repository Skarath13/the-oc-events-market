{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec wrangler dev --env lighthouse --ip 127.0.0.1 --port 4388",
      "startServerReadyPattern": "Ready on",
      "url": [
        "http://127.0.0.1:4388/",
        "http://127.0.0.1:4388/services/",
        "http://127.0.0.1:4388/events/weddings/",
        "http://127.0.0.1:4388/contact/",
        "http://127.0.0.1:4388/for-vendors/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 76800 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 51200 }],
        "uses-responsive-images": "error",
        "unsized-images": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "reports/lighthouse"
    }
  }
}
