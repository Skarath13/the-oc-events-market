# Required before launch. Use the final canonical origin with no trailing slash.
PUBLIC_SITE_URL=https://your-domain.example

# Keep false until the final domain, legal pages, and business facts are approved.
PUBLIC_SITE_INDEXABLE=false

# Set only for static staging hosts that cannot run the server form endpoints.
PUBLIC_STATIC_PREVIEW=false

# none | ga4 | plausible | umami
PUBLIC_ANALYTICS_PROVIDER=none
PUBLIC_ANALYTICS_ID=

# disabled | resend. The test value is accepted only by the Playwright test process.
FORM_DELIVERY_MODE=disabled
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=

# Optional bot defense. Configure both values together.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
