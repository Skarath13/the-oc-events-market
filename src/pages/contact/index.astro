---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TextContact from '@/components/global/TextContact.astro';
import { breadcrumbSchema } from '@/lib/seo';

const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];
---

<BaseLayout
  title="Plan Your Orange County Event"
  description="Text The OC Events Market to begin planning an Orange County wedding, shower, birthday, children’s party, corporate event, or other celebration."
  jsonLd={[breadcrumbSchema(origin, breadcrumbs)]}
>
  <div class="contact-layout">
    <div class="contact-layout__intro">
      <h1>Let’s make it unforgettable.</h1>
      <p>
        Send the occasion, a working date, the city, and what is already taking shape. A sentence is
        enough to start; the rest can still be open.
      </p>
      <p class="contact-layout__note">
        A text starts the conversation. Your date is secured after availability, scope, and booking
        are confirmed.
      </p>
    </div>
    <TextContact
      heading="Your first message can be short"
      body="Event type, estimated date, city, and guest count if you know them. We’ll take it from there."
      buttonLabel="Text Event Details"
      analyticsContext="contact"
    />
  </div>
</BaseLayout>
