---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TextContact from '@/components/global/TextContact.astro';
import { breadcrumbSchema } from '@/lib/seo';

const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];
---

<BaseLayout
  title="Plan Your Orange County Event"
  description="Text The OC Events Market to begin planning an Orange County wedding, shower, birthday, children’s party, corporate event, or other celebration."
  jsonLd={[breadcrumbSchema(origin, breadcrumbs)]}
>
  <div class="contact-layout">
    <div class="contact-layout__intro">
      <h1>Tell us what you’re planning</h1>
      <p>
        Text the occasion, a working date or planning window, and where you want help. What is still
        undecided can stay open.
      </p>
      <p class="contact-layout__note">
        Sending a text starts a conversation. It does not reserve a date or create a planning
        agreement.
      </p>
    </div>
    <TextContact
      heading="Start with a text"
      body="Include the event type, estimated date, city, and guest count if you know them. A short first message is enough."
      buttonLabel="Text Event Details"
      analyticsContext="contact"
    />
  </div>
</BaseLayout>
