---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import EventGateway from '@/components/global/EventGateway.astro';
import FaqList from '@/components/global/FaqList.astro';
import FinalCta from '@/components/global/FinalCta.astro';
import { capabilityRows, contactLinks, coreFaqs } from '@/data/site';
import { media } from '@/data/media';
import { organizationSchema, websiteSchema } from '@/lib/seo';

const heroMedia = {
  desktop: {
    mp4: '/videos/hero/oc-events-hero-desktop-v1.mp4',
    webm: '/videos/hero/oc-events-hero-desktop-v1.webm',
    poster: '/videos/hero/oc-events-hero-desktop-v1-poster.webp',
  },
  mobile: {
    mp4: '/videos/hero/oc-events-hero-mobile-v1.mp4',
    webm: '/videos/hero/oc-events-hero-mobile-v1.webm',
    poster: '/videos/hero/oc-events-hero-mobile-v1-poster.webp',
  },
} as const;
const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
---

<BaseLayout
  title="Orange County Event Planner and Designer"
  description="A dedicated planner for Orange County celebrations of every size, from intimate showers and milestone dinners to weddings and large corporate events."
  jsonLd={[organizationSchema(origin), websiteSchema(origin)]}
  bodyClass="home-page"
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      type="image/webp"
      media="(max-width: 767px)"
      href={heroMedia.mobile.poster}
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      type="image/webp"
      media="(min-width: 768px)"
      href={heroMedia.desktop.poster}
      fetchpriority="high"
    />
  </Fragment>

  <section class="home-hero">
    <div class="home-hero__copy">
      <div class="home-hero__copy-inner">
        <h1>Orange County Event Planning, Beautifully Run</h1>
        <p class="home-hero__body">
          We turn weddings, milestones, and brand moments into beautifully paced experiences—with a
          clear creative point of view, the right people, and every detail in sync.
        </p>
        <div class="home-hero__actions">
          <a
            class="button button--dark"
            href="/contact/"
            data-analytics-event="primary_cta_click"
            data-analytics-context="home_hero">Plan My Event</a
          >
          <a
            class="button button--outline"
            href={contactLinks.inquiryText}
            data-analytics-event="text_cta_click"
            data-analytics-context="home_hero">Text Event Details</a
          >
          <a class="text-link" href="/celebrations/">Explore Celebrations</a>
        </div>
        <p class="home-hero__proof">Creative vision. Calm execution. One accountable planner.</p>
      </div>
    </div>
    <div class="home-hero__media" data-home-hero-media data-video-state="poster">
      <picture class="home-hero__poster">
        <source
          media="(max-width: 767px)"
          type="image/webp"
          srcset={heroMedia.mobile.poster}
          sizes="100vw"
        />
        <source
          media="(min-width: 768px)"
          type="image/webp"
          srcset={heroMedia.desktop.poster}
          sizes="50vw"
        />
        <img
          src={heroMedia.desktop.poster}
          sizes="50vw"
          alt="Sunlit outdoor event table arranged with greenery, flowers, glassware, and woven place settings"
          width={1440}
          height={810}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </picture>
      <video
        class="home-hero__video"
        data-home-hero-video
        data-src-desktop-mp4={heroMedia.desktop.mp4}
        data-src-desktop-webm={heroMedia.desktop.webm}
        data-src-mobile-mp4={heroMedia.mobile.mp4}
        data-src-mobile-webm={heroMedia.mobile.webm}
        data-poster-desktop={heroMedia.desktop.poster}
        data-poster-mobile={heroMedia.mobile.poster}
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="metadata"
        disablepictureinpicture
        disableRemotePlayback
        aria-hidden="true"
        tabindex="-1"></video>
    </div>
  </section>

  <EventGateway
    heading="We plan the whole event—then make it feel effortless."
    intro="Big room or backyard, black tie or cake pops, the standard stays the same: considered design, sharp logistics, and a guest experience that never shows the work behind it."
    enableMotion={true}
  />

  <section class="planning-system">
    <div class="section-shell">
      <div class="section-heading section-heading--split">
        <h2>The vision is the easy part. We make it work.</h2>
        <p>
          Behind every beautiful room is a hundred well-timed decisions. We turn them into one clear
          plan, so the experience feels polished instead of produced.
        </p>
      </div>
      <div class="planning-system__grid">
        <div class="planning-system__capabilities">
          <h3>What your planner keeps in sync</h3>
          <div class="capability-index">
            {
              capabilityRows.map((capability) => (
                <article class="capability-index__item">
                  <div>
                    <h4>{capability.title}</h4>
                    <p>{capability.body}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell home-guidance">
    <article class="network-brief">
      <div class="network-brief__media">
        <Image
          src={media.network}
          alt="Intimate outdoor dining area set among deep green plants"
          widths={[400, 560, 660, 744, 840, 1120]}
          sizes="(max-width: 767px) calc(100vw - 2.5rem), 42vw"
          loading="lazy"
          quality={76}
        />
      </div>
      <div class="network-brief__copy">
        <p class="eyebrow">Your team, beautifully coordinated</p>
        <h2>Bring your favorites. We’ll bring the plan.</h2>
        <p>
          Keep the vendors you love or ask us to source the missing pieces. Either way, every
          creative partner works from the same vision, timeline, and set of priorities.
        </p>
        <a class="text-link text-link--light" href="/trusted-creative-network/"
          >Meet the coordination approach</a
        >
      </div>
    </article>
    <div class="home-guidance__faqs">
      <div class="section-heading">
        <p class="eyebrow">The quick read</p>
        <h2>Everything you want to know before hello.</h2>
        <p>Clear answers, no event-industry fog.</p>
      </div>
      <FaqList faqs={coreFaqs} />
    </div>
  </section>

  <FinalCta />
</BaseLayout>

<script>
  import { initHomeHeroVideo } from '@/lib/home-hero-video';

  initHomeHeroVideo();
</script>
