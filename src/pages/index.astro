---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import EventGateway from '@/components/global/EventGateway.astro';
import FaqList from '@/components/global/FaqList.astro';
import FinalCta from '@/components/global/FinalCta.astro';
import { capabilityRows, contactLinks, coreFaqs, processSteps } from '@/data/site';
import { media } from '@/data/media';
import { organizationSchema, websiteSchema } from '@/lib/seo';

const mobileWidths = [430, 640];
const desktopWidths = [960, 1440, 1920];
const imageSet = async (
  src: typeof media.heroDesktop,
  widths: number[],
  format: 'avif' | 'webp' | 'jpeg',
  quality: number,
) =>
  Promise.all(
    widths.map(async (width) => {
      const image = await getImage({ src, width, format, quality });
      return { src: image.src, width };
    }),
  );

const [mobileAvif, mobileWebp, desktopAvif, desktopWebp, desktopJpeg] = await Promise.all([
  imageSet(media.heroMobile, mobileWidths, 'avif', 62),
  imageSet(media.heroMobile, mobileWidths, 'webp', 68),
  imageSet(media.heroDesktop, desktopWidths, 'avif', 72),
  imageSet(media.heroDesktop, desktopWidths, 'webp', 72),
  imageSet(media.heroDesktop, desktopWidths, 'jpeg', 78),
]);
const toSrcset = (images: Array<{ src: string; width: number }>) =>
  images.map((image) => `${image.src} ${image.width}w`).join(', ');
const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
---

<BaseLayout
  title="Orange County Event Planner and Designer"
  description="A dedicated planner for Orange County celebrations of every size, from intimate showers and milestone dinners to weddings and large corporate events."
  jsonLd={[organizationSchema(origin), websiteSchema(origin)]}
  bodyClass="home-page"
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      type="image/avif"
      media="(max-width: 767px)"
      imagesrcset={toSrcset(mobileAvif)}
      imagesizes="100vw"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      type="image/avif"
      media="(min-width: 768px)"
      imagesrcset={toSrcset(desktopAvif)}
      imagesizes="50vw"
      fetchpriority="high"
    />
  </Fragment>

  <section class="home-hero">
    <div class="home-hero__copy">
      <div class="home-hero__copy-inner">
        <h1>A Planner for Every Celebration</h1>
        <p class="home-hero__body">
          Across Orange County, from intimate showers and milestone dinners to weddings and large
          corporate events, we shape the vision, coordinate every vendor, and manage the details so
          you can be fully present.
        </p>
        <div class="home-hero__actions">
          <a
            class="button button--dark"
            href="/contact/"
            data-analytics-event="primary_cta_click"
            data-analytics-context="home_hero">Plan My Event</a
          >
          <a
            class="button button--outline"
            href={contactLinks.text}
            data-analytics-event="text_cta_click"
            data-analytics-context="home_hero">Text Event Details</a
          >
          <a class="text-link" href="/celebrations/">Explore Celebrations</a>
        </div>
        <p class="home-hero__proof">Your planner keeps every detail connected</p>
      </div>
    </div>
    <div class="home-hero__media">
      <picture>
        <source
          media="(max-width: 767px)"
          type="image/avif"
          srcset={toSrcset(mobileAvif)}
          sizes="100vw"
        />
        <source
          media="(max-width: 767px)"
          type="image/webp"
          srcset={toSrcset(mobileWebp)}
          sizes="100vw"
        />
        <source
          media="(min-width: 768px)"
          type="image/avif"
          srcset={toSrcset(desktopAvif)}
          sizes="50vw"
        />
        <source
          media="(min-width: 768px)"
          type="image/webp"
          srcset={toSrcset(desktopWebp)}
          sizes="50vw"
        />
        <img
          src={desktopJpeg.at(-1)?.src}
          srcset={toSrcset(desktopJpeg)}
          sizes="50vw"
          alt="Outdoor event table layered with yellow flowers, glassware, woven place settings, and soft blue linens"
          width={1920}
          height={1280}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </picture>
    </div>
  </section>

  <EventGateway
    heading="We plan the whole event, at every size."
    intro="From the first idea to the final vendor arrival, we build the plan, guide the creative direction, and keep every moving part aligned. Your planner stays close to the decisions while you keep the space to enjoy the reason everyone is gathering."
  />

  <section class="planning-system">
    <div class="section-shell">
      <div class="section-heading section-heading--split">
        <h2>One plan for every moving piece.</h2>
        <p>
          The exact work depends on your selected service. What we own, what you approve, and what
          each vendor handles are made clear before planning starts.
        </p>
      </div>
      <div class="planning-system__grid">
        <div class="planning-system__capabilities">
          <h3>What planning can connect</h3>
          <div class="capability-index">
            {
              capabilityRows.map((capability) => (
                <article class="capability-index__item">
                  <div>
                    <h4>{capability.title}</h4>
                    <p>{capability.body}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
        <div class="planning-system__process">
          <h3>How the work moves</h3>
          <p class="planning-system__process-intro">
            A calm process is still detailed. The plan is simply presented in the order you need it.
          </p>
          <ol class="process-stack">
            {
              processSteps.map((step, index) => (
                <li class="process-stack__step">
                  <span class="process-stack__number" aria-hidden="true">
                    0{index + 1}
                  </span>
                  <div>
                    <h4>{step.title}</h4>
                    <p>{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell home-guidance">
    <article class="network-brief">
      <div class="network-brief__media">
        <Image
          src={media.network}
          alt="Intimate outdoor dining area set among deep green plants"
          widths={[560, 840, 1120]}
          sizes="(max-width: 767px) 100vw, 42vw"
          loading="lazy"
          quality={76}
        />
      </div>
      <div class="network-brief__copy">
        <p class="eyebrow">Vendor flexibility</p>
        <h2>Bring your vendors or ask us to find them.</h2>
        <p>
          We can recommend professionals when sourcing is included or coordinate vendors you have
          already chosen. Either way, everyone works from one plan, one timeline, and one direction.
        </p>
        <a class="text-link text-link--light" href="/trusted-creative-network/"
          >How vendor coordination works</a
        >
      </div>
    </article>
    <div class="home-guidance__faqs">
      <div class="section-heading">
        <p class="eyebrow">Before you inquire</p>
        <h2>Useful answers before we talk.</h2>
        <p>Package details are always confirmed in writing.</p>
      </div>
      <FaqList faqs={coreFaqs} />
    </div>
  </section>

  <FinalCta />
</BaseLayout>
