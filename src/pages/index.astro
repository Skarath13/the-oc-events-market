---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ActualWorkGallery from '@/components/global/ActualWorkGallery.astro';
import CapabilityIndex from '@/components/global/CapabilityIndex.astro';
import EventGateway from '@/components/global/EventGateway.astro';
import FaqList from '@/components/global/FaqList.astro';
import FinalCta from '@/components/global/FinalCta.astro';
import { contactLinks, coreFaqs } from '@/data/site';
import { media } from '@/data/media';
import { organizationSchema, websiteSchema } from '@/lib/seo';

const heroMedia = {
  desktop: {
    mp4: '/videos/hero/oc-events-hero-desktop-v1.mp4',
    webm: '/videos/hero/oc-events-hero-desktop-v1.webm',
    poster: '/videos/hero/oc-events-hero-desktop-v1-poster.webp',
  },
  mobile: {
    mp4: '/videos/hero/oc-events-hero-mobile-v1.mp4',
    webm: '/videos/hero/oc-events-hero-mobile-v1.webm',
    poster: '/videos/hero/oc-events-hero-mobile-v1-poster.webp',
  },
} as const;
const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
---

<BaseLayout
  title="Orange County Event Planner and Designer"
  description="Distinctive event planning and design for weddings, milestone celebrations, showers, private parties, and brand events across Orange County."
  jsonLd={[organizationSchema(origin), websiteSchema(origin)]}
  bodyClass="home-page"
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      type="image/webp"
      media="(max-width: 767px)"
      href={heroMedia.mobile.poster}
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      type="image/webp"
      media="(min-width: 768px)"
      href={heroMedia.desktop.poster}
      fetchpriority="high"
    />
  </Fragment>

  <section class="home-hero">
    <div class="home-hero__copy">
      <div class="home-hero__copy-inner" data-site-hero>
        <h1>Orange County Event Planning, Beautifully Run</h1>
        <p class="home-hero__body">
          We turn weddings, milestones, and brand moments into beautifully paced experiences. A
          clear creative point of view, the right people, and every detail stay in sync.
        </p>
        <div class="home-hero__actions">
          <a
            class="button button--dark"
            href="/contact/"
            data-analytics-event="primary_cta_click"
            data-analytics-context="home_hero">Plan My Event</a
          >
          <a
            class="button button--outline"
            href={contactLinks.inquiryText}
            data-analytics-event="text_cta_click"
            data-analytics-context="home_hero">Text Event Details</a
          >
          <a class="text-link" href="/celebrations/">Explore Celebrations</a>
        </div>
        <p class="home-hero__proof">Creative vision. Calm execution. One accountable planner.</p>
      </div>
    </div>
    <div class="home-hero__media" data-home-hero-media data-video-state="poster">
      <picture class="home-hero__poster">
        <source
          media="(max-width: 767px)"
          type="image/webp"
          srcset={heroMedia.mobile.poster}
          sizes="100vw"
        />
        <source
          media="(min-width: 768px)"
          type="image/webp"
          srcset={heroMedia.desktop.poster}
          sizes="100vw"
        />
        <img
          src={heroMedia.desktop.poster}
          sizes="100vw"
          alt="Sunlit outdoor event table arranged with greenery, flowers, glassware, and woven place settings"
          width={1440}
          height={810}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </picture>
      <video
        class="home-hero__video"
        data-home-hero-video
        data-src-desktop-mp4={heroMedia.desktop.mp4}
        data-src-desktop-webm={heroMedia.desktop.webm}
        data-src-mobile-mp4={heroMedia.mobile.mp4}
        data-src-mobile-webm={heroMedia.mobile.webm}
        data-poster-desktop={heroMedia.desktop.poster}
        data-poster-mobile={heroMedia.mobile.poster}
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="metadata"
        disablepictureinpicture
        disableRemotePlayback
        aria-hidden="true"
        tabindex="-1"></video>
    </div>
    <div class="home-hero__transition" aria-hidden="true"></div>
  </section>

  <EventGateway
    heading="The Occasion Changes. The Standard Does Not."
    intro="From intimate gatherings to celebrations on a grand scale, every event is shaped around a clear idea, a precise plan, and the people at its center."
    enableMotion={true}
  />

  <section class="planning-system">
    <div class="section-shell">
      <div class="section-heading section-heading--split" data-site-reveal>
        <h2>The Beauty Is in the Details. The Ease Is in the Plan.</h2>
        <p>
          We align the creative, logistical, and budget decisions early, then direct every moving
          part with quiet precision.
        </p>
      </div>
      <div class="planning-system__grid">
        <div class="planning-system__capabilities">
          <h3>One vision. Every detail in step.</h3>
          <CapabilityIndex headingLevel={4} />
        </div>
      </div>
      <p class="narrative-bridge planning-system__bridge" data-site-reveal>
        When the plan is clear, the smallest details your guests see have room to feel effortless.
      </p>
    </div>
  </section>

  <ActualWorkGallery />

  <section class="section-shell home-guidance">
    <p class="narrative-bridge home-guidance__bridge" data-site-reveal>
      The finished room comes from the right team, aligned early, with the right questions answered.
    </p>
    <article class="network-brief" data-site-reveal>
      <div class="network-brief__media">
        <Image
          src={media.actualDuckCakePops}
          alt="Mint green cake pops finished with yellow ducks and pearl sprinkles"
          widths={[400, 560, 660, 744, 840, 1120]}
          sizes="(max-width: 767px) calc(100vw - 2.5rem), 42vw"
          loading="lazy"
          quality={76}
        />
      </div>
      <div class="network-brief__copy">
        <p class="eyebrow">Built Around Your Vision</p>
        <h2>The Right Partners. One Clear Direction.</h2>
        <p>
          Bring the team you trust, or let us curate the missing pieces. We align every creative
          partner around the same vision, standards, and production plan.
        </p>
        <a class="text-link text-link--light" href="/trusted-creative-network/"
          >See How We Coordinate</a
        >
      </div>
    </article>
    <div class="home-guidance__faqs">
      <div class="section-heading" data-site-reveal>
        <p class="eyebrow">Before We Begin</p>
        <h2>The Questions Worth Asking.</h2>
        <p>Straight answers before a single detail is decided.</p>
      </div>
      <FaqList faqs={coreFaqs} />
    </div>
  </section>

  <FinalCta />
</BaseLayout>

<script>
  import { initHomeHeroVideo } from '@/lib/home-hero-video';

  initHomeHeroVideo();
</script>
