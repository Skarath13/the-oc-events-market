---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/global/PageHero.astro';
import EventGateway from '@/components/global/EventGateway.astro';
import FinalCta from '@/components/global/FinalCta.astro';
import { media } from '@/data/media';
import { breadcrumbSchema } from '@/lib/seo';

const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Celebrations', path: '/celebrations/' },
];
---

<BaseLayout
  title="Orange County Celebrations and Event Design"
  description="Explore planning and design for Orange County weddings, showers, birthdays, kids’ parties, and corporate events."
  jsonLd={[breadcrumbSchema(origin, breadcrumbs)]}
>
  <PageHero
    title="Every Celebration Deserves Its Own Point of View"
    summary="A wedding should not feel like a brand event. A first birthday should not move like a dinner party. We shape the design, pace, and production around the people in the room."
    image={media.venue}
    imageAlt="Sunlit outdoor tables arranged for a gathering"
  />

  <EventGateway
    heading="Start with the reason everyone is gathering."
    intro="From there, we build the room, rhythm, vendors, and guest experience around what makes this occasion unmistakably yours."
  />
  <FinalCta />
</BaseLayout>
