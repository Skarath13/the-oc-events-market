---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbSchema } from '@/lib/seo';

const publishedEntries = await getCollection('journal', ({ data }) => !data.draft);
const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Journal', path: '/journal/' },
];
---

<BaseLayout
  title="Orange County Event Planning Journal"
  description="Practical Orange County event planning guidance about timelines, vendors, venues, design decisions, logistics, and levels of support."
  noindex={publishedEntries.length === 0}
  jsonLd={[breadcrumbSchema(origin, breadcrumbs)]}
>
  <section class="section-shell journal-page">
    <header class="journal-page__header">
      <h1>Planning Notes for Thoughtful Hosts</h1>
      <p>
        Practical guidance based on firsthand planning experience. Articles publish only with a real
        process, useful examples, and facts the owner has approved.
      </p>
    </header>
    {
      publishedEntries.length > 0 ? (
        <div class="detail-list">
          {publishedEntries.map((entry) => (
            <a class="detail-list__item" href={`/journal/${entry.id}/`}>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="journal-page__status">
          <h2>Briefs are ready. Filler is not.</h2>
          <div class="detail-intro__body">
            <p>
              Eight briefs are ready for owner review. They cover planning from start to finish,
              vendor flexibility, celebration timelines, showers, venues, outdoor events, planning
              versus coordination, and timelines for multiple vendors.
            </p>
            <p>
              This route stays noindex and out of primary navigation until an article has verified
              authorship, firsthand material, useful support, and an approved publication date.
            </p>
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>
