---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbSchema } from '@/lib/seo';

const publishedEntries = await getCollection('journal', ({ data }) => !data.draft);
const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Journal', path: '/journal/' },
];
---

<BaseLayout
  title="Orange County Event Planning Journal"
  description="Practical Orange County event planning guidance about timelines, vendors, venues, design decisions, logistics, and levels of support."
  noindex={publishedEntries.length === 0}
  jsonLd={[breadcrumbSchema(origin, breadcrumbs)]}
>
  <section class="section-shell journal-page">
    <header class="journal-page__header">
      <h1>Planning Notes for Thoughtful Hosts</h1>
      <p>
        Specific, useful thinking on venues, vendors, timelines, design decisions, and the details
        that quietly change an event.
      </p>
    </header>
    {
      publishedEntries.length > 0 ? (
        <div class="detail-list">
          {publishedEntries.map((entry) => (
            <a class="detail-list__item" href={`/journal/${entry.id}/`}>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="journal-page__status">
          <h2>Good advice should earn its place at the table.</h2>
          <div class="detail-intro__body">
            <p>
              Explore the services and celebration pages for clear thinking on creative direction,
              logistics, vendor flow, and the decisions that make an event feel effortless.
            </p>
            <p>
              Or start with your own event.
              <a class="text-link" href="/contact/">
                Tell us what you’re planning
              </a>
              .
            </p>
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>
