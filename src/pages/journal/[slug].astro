---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FinalCta from '@/components/global/FinalCta.astro';
import { breadcrumbSchema, organizationId } from '@/lib/seo';

export async function getStaticPaths() {
  const entries = await getCollection('journal', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = {
  entry: Awaited<ReturnType<typeof getCollection<'journal'>>>[number];
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const path = `/journal/${entry.id}/`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Journal', path: '/journal/' },
  { name: entry.data.title, path },
];
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${new URL(path, origin).href}#article`,
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt?.toISOString(),
  dateModified: (entry.data.updatedAt ?? entry.data.publishedAt)?.toISOString(),
  author: entry.data.author ? { '@type': 'Person', name: entry.data.author } : undefined,
  publisher: { '@id': organizationId(origin) },
  mainEntityOfPage: new URL(path, origin).href,
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  jsonLd={[breadcrumbSchema(origin, breadcrumbs), articleSchema]}
>
  <article class="prose-page">
    <h1>{entry.data.title}</h1>
    {
      entry.data.publishedAt && (
        <p>Published {entry.data.publishedAt.toLocaleDateString('en-US')}</p>
      )
    }
    <p>{entry.data.description}</p>
    <Content />
  </article>
  <FinalCta />
</BaseLayout>
