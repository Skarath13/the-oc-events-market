---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/global/PageHero.astro';
import EventGateway from '@/components/global/EventGateway.astro';
import FinalCta from '@/components/global/FinalCta.astro';
import { capabilityRows } from '@/data/site';
import { media } from '@/data/media';
import { breadcrumbSchema, serviceSchema } from '@/lib/seo';

const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
];
---

<BaseLayout
  title="Event Planning Services in Orange County"
  description="Explore planning, design, vendor coordination, logistics, and support on the event day for Orange County celebrations. Scope is confirmed in your selected service."
  jsonLd={[
    breadcrumbSchema(origin, breadcrumbs),
    serviceSchema({
      origin,
      pathname: '/services/',
      name: 'Orange County event planning and design',
      description:
        'Planning, design, vendor coordination, logistics, and included support on the event day for Orange County celebrations.',
      serviceType: 'Event planning and design',
    }),
  ]}
>
  <PageHero
    title="Planning Support That Fits the Event"
    summary="Choose the support your Orange County event actually needs. Your planner can shape the vision, organize decisions, coordinate vendors, and manage the work stated in your selected service."
    image={media.planningDetail}
    imageAlt="Flowers, glassware, and candlelight arranged for a dinner"
    proof="A dedicated planner with the exact scope confirmed in writing"
  />

  <section class="section-shell service-scope">
    <div class="service-scope__intro">
      <div>
        <p class="eyebrow">Built around the event</p>
        <h2>Start with what is already decided.</h2>
      </div>
      <div>
        <p>
          Some hosts need help from the earliest idea. Others already have a venue, vendors, or
          design direction and need someone to organize what remains.
        </p>
        <p>
          Exact package names, inclusions, staffing, meetings, and hours on the event day are not
          published until the owner confirms them. That keeps clients from relying on an unverified
          promise.
        </p>
      </div>
    </div>
    <div class="service-scope__capabilities">
      <div class="section-heading section-heading--split">
        <h2>Planning responsibilities in plain language.</h2>
        <p>
          These are possible workstreams, not a claim that every item is included in every
          engagement.
        </p>
      </div>
      <div class="capability-index">
        {
          capabilityRows.map((capability) => (
            <article class="capability-index__item">
              <div>
                <h3>{capability.title}</h3>
                <p>{capability.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <EventGateway
    heading="The event type changes the plan."
    intro="A wedding, children’s party, shower, milestone dinner, and corporate event do not share the same operational priorities."
  />
  <FinalCta />
</BaseLayout>
