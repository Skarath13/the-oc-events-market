---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CapabilityIndex from '@/components/global/CapabilityIndex.astro';
import PageHero from '@/components/global/PageHero.astro';
import EventGateway from '@/components/global/EventGateway.astro';
import FinalCta from '@/components/global/FinalCta.astro';
import { media } from '@/data/media';
import { breadcrumbSchema, serviceSchema } from '@/lib/seo';

const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
];
---

<BaseLayout
  title="Event Planning Services in Orange County"
  description="Explore Orange County event planning, design, vendor coordination, logistics, and event day management shaped around what your celebration needs."
  jsonLd={[
    breadcrumbSchema(origin, breadcrumbs),
    serviceSchema({
      origin,
      pathname: '/services/',
      name: 'Orange County event planning and design',
      description:
        'Planning, design, vendor coordination, logistics, and included support on the event day for Orange County celebrations.',
      serviceType: 'Event planning and design',
    }),
  ]}
>
  <PageHero
    title="Event Planning Services in Orange County"
    image={media.actualWeddingTablescape}
    imageAlt="Wedding tables with ivory linens, floral centerpieces, gold chargers, and blue goblets"
    imageFit="cover"
    proof="The right support. A clear proposal. One accountable planner."
  />

  <section class="section-shell service-scope">
    <div class="service-scope__intro" data-site-reveal>
      <div>
        <h2>Bring the vision, the venue, or just the date.</h2>
      </div>
      <div>
        <p>
          Some events begin with a blank page. Others arrive with a venue, a few vendors, and a
          folder full of inspiration. We meet the plan where it is and make the next move obvious.
        </p>
      </div>
    </div>
    <div class="service-scope__capabilities">
      <div class="section-heading" data-site-reveal>
        <h2>Everything that turns an idea into an event.</h2>
      </div>
      <CapabilityIndex headingLevel={3} />
    </div>
  </section>

  <EventGateway
    heading="The occasion changes the plan."
    intro="A wedding, first birthday, shower, milestone dinner, and brand event each need a different rhythm. We plan accordingly."
    enableMotion={true}
  />
  <FinalCta />
</BaseLayout>
