---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/global/PageHero.astro';
import FinalCta from '@/components/global/FinalCta.astro';
import { media } from '@/data/media';
import { breadcrumbSchema } from '@/lib/seo';

const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];
---

<BaseLayout
  title="About Ivone and The OC Events Market"
  description="Meet Ivone and discover the thoughtful, hands-on approach behind The OC Events Market."
  jsonLd={[breadcrumbSchema(origin, breadcrumbs)]}
>
  <PageHero
    title="Meet Ivone. Close to Every Detail."
    summary="At The OC Events Market, creative choices, vendor handoffs, and event-day logistics belong to one connected plan—so the celebration can feel beautifully effortless."
    image={media.heroDesktop}
    imageAlt="Layered outdoor event table with florals, linens, and glassware"
  />

  <section class="section-shell profile-panel">
    <div class="profile-panel__media">
      <img
        src="/videos/actual/actual-ivone-event-details-v1-poster.webp"
        alt="Ivone arranging a sweets display before an outdoor event"
        width="576"
        height="768"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="profile-panel__copy">
      <p class="eyebrow">A hands-on point of view</p>
      <h2>Good taste is only the beginning.</h2>
      <p>
        A beautiful event starts with a point of view. A great one also knows exactly when the
        rentals arrive, where guests naturally gather, and who owns every handoff behind the scenes.
      </p>
      <p>
        The OC Events Market brings those worlds together: the room, the rhythm, the food, the
        florals, the entertainment, and the people making it happen. Bring vendors you trust or ask
        for recommendations that fit the plan.
      </p>
      <aside class="profile-panel__note">
        <h3>One direction, from idea to event day.</h3>
        <p>
          Creative decisions, vendor communication, and the current timeline stay connected, so the
          people bringing the event to life are working from the same direction.
        </p>
      </aside>
    </div>
  </section>
  <FinalCta />
</BaseLayout>
