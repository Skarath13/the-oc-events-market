---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/global/PageHero.astro';
import FinalCta from '@/components/global/FinalCta.astro';
import { media } from '@/data/media';
import { breadcrumbSchema } from '@/lib/seo';

const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];
---

<BaseLayout
  title="About The OC Events Market"
  description="Meet the planner-led approach behind The OC Events Market, connecting the vision, vendors, logistics, and event day for Orange County celebrations."
  jsonLd={[breadcrumbSchema(origin, breadcrumbs)]}
>
  <PageHero
    title="A Planner Focused on the Whole Event"
    summary="The OC Events Market is a planner-led Orange County planning and design practice. From the first conversation through event day, your planner keeps the vision, decisions, vendors, and logistics connected."
    image={media.heroDesktop}
    imageAlt="Layered outdoor event table with florals, linens, and glassware"
  />

  <section class="section-shell detail-intro">
    <h2>Creative direction and operational clarity belong together.</h2>
    <div class="detail-intro__body">
      <p>
        A celebration can look cohesive only when the choices behind it connect: the room, guest
        flow, food, rentals, florals, entertainment, lighting, schedule, and vendor handoffs.
      </p>
      <p>
        We shape those connected decisions and coordinate every approved professional around one
        plan. You can use trusted recommendations or bring people you already know.
      </p>
    </div>
  </section>

  <section class="clarification surface-white">
    <div class="clarification__media">
      <Image
        src={media.planningDetail}
        alt="Event table detail with flowers, candles, and glassware"
        widths={[560, 840, 1120]}
        sizes="(max-width: 767px) 92vw, 48vw"
        loading="lazy"
        quality={76}
      />
    </div>
    <div class="clarification__copy">
      <h2>A direct planning relationship.</h2>
      <p>
        Your planner stays close to the vision and the decisions while every approved contributor
        works from the same direction. A fuller planner biography and portrait will be added when
        those details and photography are verified and ready to share.
      </p>
    </div>
  </section>
  <FinalCta />
</BaseLayout>
