---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/global/PageHero.astro';
import FinalCta from '@/components/global/FinalCta.astro';
import { media } from '@/data/media';
import { breadcrumbSchema } from '@/lib/seo';

const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];
---

<BaseLayout
  title="About The OC Events Market"
  description="Meet the dedicated planner behind The OC Events Market, connecting the vision, vendors, logistics, and event day for Orange County celebrations."
  jsonLd={[breadcrumbSchema(origin, breadcrumbs)]}
>
  <PageHero
    title="One Planner for the Whole Event"
    summary="The OC Events Market is an Orange County planning and design practice led by a dedicated planner who keeps the vision, decisions, vendors, and logistics connected."
    image={media.heroDesktop}
    imageAlt="Layered outdoor event table with florals, linens, and glassware"
  />

  <section class="section-shell profile-panel">
    <div class="profile-panel__media">
      <Image
        src={media.planningDetail}
        alt="Event table detail with flowers, candles, and glassware"
        widths={[560, 840, 1120]}
        sizes="(max-width: 767px) 100vw, 42vw"
        loading="lazy"
        quality={76}
      />
    </div>
    <div class="profile-panel__copy">
      <p class="eyebrow">Planning and design</p>
      <h2>Creative direction meets operational clarity.</h2>
      <p>
        A celebration can look cohesive only when the choices behind it connect: the room, guest
        flow, food, rentals, florals, entertainment, lighting, schedule, and vendor handoffs.
      </p>
      <p>
        We shape those connected decisions and coordinate every approved professional around one
        plan. You can use trusted recommendations or bring people you already know.
      </p>
      <aside class="profile-panel__note">
        <h3>A direct planning relationship</h3>
        <p>
          Your planner stays close to the vision and decisions while every approved contributor
          works from the same direction. A fuller biography and portrait will be added when those
          details and photography are verified and ready to share.
        </p>
      </aside>
    </div>
  </section>
  <FinalCta />
</BaseLayout>
