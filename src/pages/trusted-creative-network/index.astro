---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/global/PageHero.astro';
import FaqList from '@/components/global/FaqList.astro';
import FinalCta from '@/components/global/FinalCta.astro';
import { media } from '@/data/media';
import { breadcrumbSchema } from '@/lib/seo';

const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Vendor Coordination', path: '/trusted-creative-network/' },
];
const faqs = [
  {
    question: 'Are clients required to use preferred vendors?',
    answer:
      'No. You may bring professionals you already know and love. We coordinate them according to the selected planning scope.',
  },
  {
    question: 'Can you recommend vendors?',
    answer:
      'Yes, when vendor sourcing is included. We recommend professionals based on the event’s needs, visual direction, logistics, and working budget.',
  },
  {
    question: 'Does a recommendation guarantee availability or pricing?',
    answer:
      'No. Vendor availability, contracts, pricing, insurance, licenses, and service terms belong to the vendor relationship and must be reviewed before booking.',
  },
  {
    question: 'Will existing vendors be included in the timeline?',
    answer:
      'Existing vendors can be brought into the approved communication and timeline process when that coordination is included in the selected service.',
  },
];
---

<BaseLayout
  title="Planner-Led Vendor Coordination"
  description="Bring vendors you already trust or ask for recommendations. Your planner coordinates every approved professional around a shared plan and timeline."
  jsonLd={[breadcrumbSchema(origin, breadcrumbs)]}
>
  <PageHero
    title="A Planner at the Center of Every Moving Piece"
    summary="Bring the vendors you already trust or ask us to find the right professionals when sourcing is included. Your planner keeps the introductions, communication, dependencies, and timeline connected."
    image={media.network}
    imageAlt="Intimate outdoor event setting surrounded by greenery"
  />

  <section class="section-shell vendor-flex">
    <div>
      <h2>The right vendors, coordinated around your event.</h2>
      <p>
        The right group of professionals depends on the event, priorities, setting, working budget,
        and responsibilities already in place. We bring everyone into a shared direction and one
        current timeline.
      </p>
      <a class="text-link" href="/for-vendors/">Introduce your work</a>
    </div>
    <p class="vendor-flex__rule">
      Trusted recommendations when needed. Existing relationships when preferred.
    </p>
  </section>

  <section class="section-shell">
    <div class="section-heading">
      <h2>How vendor coordination works.</h2>
    </div>
    <FaqList faqs={faqs} />
  </section>
  <FinalCta />
</BaseLayout>
