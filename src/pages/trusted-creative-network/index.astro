---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/global/PageHero.astro';
import FaqList from '@/components/global/FaqList.astro';
import FinalCta from '@/components/global/FinalCta.astro';
import { media } from '@/data/media';
import { breadcrumbSchema } from '@/lib/seo';

const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Vendor Coordination', path: '/trusted-creative-network/' },
];
const faqs = [
  {
    question: 'Are clients required to use preferred vendors?',
    answer:
      'No. Bring the professionals you already know and love. We fold them into the same creative direction, communication rhythm, and event timeline.',
  },
  {
    question: 'Can you recommend vendors?',
    answer:
      'Yes, when sourcing is part of your proposal. We recommend professionals based on the vision, logistics, personality, and working budget of the event.',
  },
  {
    question: 'Does a recommendation guarantee availability or pricing?',
    answer:
      'No. Each vendor confirms their own availability, pricing, insurance, licenses, contract, and service terms before booking.',
  },
  {
    question: 'Will existing vendors be included in the timeline?',
    answer:
      'Yes, when their coordination is part of your proposal. We bring their arrivals, dependencies, and responsibilities into the current timeline.',
  },
];
---

<BaseLayout
  title="Vendor Coordination Led by Your Planner"
  description="Bring vendors you already trust or ask for recommendations. Your planner coordinates every approved professional around a shared plan and timeline."
  jsonLd={[breadcrumbSchema(origin, breadcrumbs)]}
>
  <PageHero
    title="Great Events Need More Than Great Vendors"
    summary="They need one direction. Bring the professionals you trust or ask us to find the missing pieces; your planner keeps every relationship, dependency, and deadline moving together."
    image={media.actualDuckCakePops}
    imageAlt="Mint green cake pops topped with yellow ducks and pearl sprinkles sit in a clear stand"
    imageFit="contain"
    proof="Your vendors. Our coordination. One current plan."
  />

  <section class="section-shell network-page">
    <div class="network-page__brief" data-site-reveal>
      <p class="eyebrow">A flexible creative network</p>
      <h2>Curated for the event. Coordinated as one team.</h2>
      <p>
        The right team depends on the room, priorities, personality, and working budget. We build
        around what is already working, source what is missing, and bring everyone into one current
        plan.
      </p>
      <p class="network-page__rule">
        Your favorites when you have them. Our recommendations when you need them.
      </p>
      <a class="text-link text-link--light" href="/for-vendors/">Introduce your work</a>
    </div>
    <div class="network-page__faqs">
      <div class="section-heading" data-site-reveal>
        <p class="eyebrow">The working relationship</p>
        <h2>How we keep the team in sync</h2>
      </div>
      <FaqList faqs={faqs} />
    </div>
  </section>
  <FinalCta />
</BaseLayout>
