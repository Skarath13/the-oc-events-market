---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TextContact from '@/components/global/TextContact.astro';
import { contactLinks } from '@/data/site';
import { breadcrumbSchema } from '@/lib/seo';

const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Introduce Your Work', path: '/for-vendors/' },
];
---

<BaseLayout
  title="Introduce Your Event Business"
  description="Text your event business, service area, portfolio, and capabilities directly to the planner behind The OC Events Market."
  jsonLd={[breadcrumbSchema(origin, breadcrumbs)]}
>
  <div class="contact-layout">
    <div class="contact-layout__intro">
      <h1>Show us what you do best.</h1>
      <p>
        Text your business name, specialty, service area, and a link that shows your strongest work.
      </p>
      <p class="contact-layout__note">
        Keep the first message centered on your portfolio. Please do not send sensitive license,
        insurance, payment, or identity information by text.
      </p>
    </div>
    <TextContact
      heading="Make the introduction memorable"
      body="Share a portfolio or website and one concise line about the kind of events where your work shines."
      buttonLabel="Text a Vendor Introduction"
      analyticsContext="vendor"
      href={contactLinks.vendorIntroductionText}
    />
  </div>
</BaseLayout>
