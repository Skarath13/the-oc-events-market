---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VendorInquiryForm from '@/components/forms/VendorInquiryForm.astro';
import { breadcrumbSchema } from '@/lib/seo';

const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Introduce Your Work', path: '/for-vendors/' },
];
---

<BaseLayout
  title="Introduce Your Event Business"
  description="Share your event business, service area, portfolio, and capabilities directly with the planner behind The OC Events Market."
  jsonLd={[breadcrumbSchema(origin, breadcrumbs)]}
>
  <div class="form-layout">
    <div class="form-layout__intro">
      <h1>Introduce your work to the planner.</h1>
      <p>
        We review vendor introductions separately from client inquiries. Share your service area,
        portfolio, and a clear explanation of how you support well-coordinated events.
      </p>
      <p class="form-layout__note">
        Submitting this form does not create a partnership, recommendation, or preferred status. Do
        not enter sensitive license or insurance document numbers.
      </p>
    </div>
    <VendorInquiryForm />
  </div>
</BaseLayout>
