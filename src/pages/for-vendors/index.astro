---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TextContact from '@/components/global/TextContact.astro';
import { breadcrumbSchema } from '@/lib/seo';

const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Introduce Your Work', path: '/for-vendors/' },
];
---

<BaseLayout
  title="Introduce Your Event Business"
  description="Text your event business, service area, portfolio, and capabilities directly to the planner behind The OC Events Market."
  jsonLd={[breadcrumbSchema(origin, breadcrumbs)]}
>
  <div class="contact-layout">
    <div class="contact-layout__intro">
      <h1>Introduce your work</h1>
      <p>
        Vendor introductions are separate from client inquiries. Text your business name, service
        category, and service area.
      </p>
      <p class="contact-layout__note">
        A text introduction does not create a partnership, recommendation, or preferred status. Do
        not send sensitive license, insurance, payment, or identity information.
      </p>
    </div>
    <TextContact
      heading="Start with a text"
      body="Include a portfolio or website link and a concise explanation of how you support coordinated events."
      buttonLabel="Text a Vendor Introduction"
      analyticsContext="vendor"
    />
  </div>
</BaseLayout>
