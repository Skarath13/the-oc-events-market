---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/global/PageHero.astro';
import FinalCta from '@/components/global/FinalCta.astro';
import { processSteps } from '@/data/site';
import { media } from '@/data/media';
import { breadcrumbSchema } from '@/lib/seo';

const origin = Astro.site ?? new URL('https://the-oc-events-market.example');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'The Process', path: '/process/' },
];
---

<BaseLayout
  title="The Event Planning Process"
  description="See how discovery, planning and design, vendor coordination, and management on the event day come together around one clear event plan."
  jsonLd={[breadcrumbSchema(origin, breadcrumbs)]}
>
  <PageHero
    title="From First Idea to Event Day"
    summary="A smooth celebration starts before the first vendor arrives. We turn priorities into decisions, bring every contributor into one plan, and carry it through the event so you can be present as the host."
    image={media.network}
    imageAlt="Outdoor dining space arranged among greenery"
  />

  <section class="section-shell process-page">
    <div class="section-heading section-heading--split">
      <h2>Four stages. One connected plan.</h2>
      <p>
        The timing and deliverables depend on the selected service. The structure keeps
        responsibilities and next decisions visible.
      </p>
    </div>
    <ol class="process-rail">
      {
        processSteps.map((step, index) => (
          <li class="process-rail__step">
            <span class="process-rail__number" aria-hidden="true">
              0{index + 1}
            </span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
    <div class="process-page__note">
      <h3>What makes the process feel calm?</h3>
      <div>
        <p>
          Calm does not mean casual. It means the owner of each decision is known, every vendor
          works from current information, and each deadline arrives with enough context for a useful
          choice.
        </p>
        <p>
          When conditions change, we trace the dependencies, update the approved plan, and relay the
          adjustment without making you relay every message.
        </p>
      </div>
    </div>
  </section>
  <FinalCta />
</BaseLayout>
