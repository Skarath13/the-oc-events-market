---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { eventTypes } from '@/data/eventTypes';
import { media } from '@/data/media';

type Props = {
  heading?: string;
  intro?: string;
  note?: string;
  enableMotion?: boolean;
};

type MotionPresentation = {
  id: 'dessert' | 'ivone';
  mp4: string;
  poster?: string;
  width: number;
  height: number;
  description: string;
};

type GatewayPresentation = {
  image: ImageMetadata;
  alt: string;
  caption: string;
  label: string;
  ratio: 'landscape' | 'portrait';
  motion?: MotionPresentation;
};

const {
  heading = 'One studio. Every kind of celebration.',
  intro = 'The guest list changes. The standard does not. Expect considered design, sharp logistics, and a celebration that never shows the work behind it.',
  note,
  enableMotion = false,
} = Astro.props;

const presentations: Record<string, GatewayPresentation> = {
  weddings: {
    image: media.actualDessertFavorCollection,
    alt: 'Four dessert favor presentations with mini cakes and decorated cake pops in blush packaging',
    caption: 'The final impression matters.',
    label: 'Wedding planning and design',
    ratio: 'landscape',
  },
  'baby-bridal-showers': {
    image: media.actualDuckCakePops,
    alt: 'Mint green cake pops finished with yellow ducks and pearl sprinkles',
    caption: 'Small detail. Signature impact.',
    label: 'Baby and bridal showers',
    ratio: 'landscape',
    motion: {
      id: 'dessert',
      mp4: '/videos/actual/actual-dessert-finishing-v1.mp4',
      width: 576,
      height: 480,
      description: 'a planner adding the final touches to a dessert display',
    },
  },
  'birthdays-milestones': {
    image: media.actualFiftiethMilestoneBalloonBackdrop,
    alt: 'Black, gold, and silver balloons frame a round black backdrop with gold number 50 balloons',
    caption: 'A milestone with presence.',
    label: 'Birthdays and milestones',
    ratio: 'portrait',
  },
  'kids-parties': {
    image: media.actualFirstBirthdayBalloonBackdrop,
    alt: 'Red, white, and yellow balloons frame a white backdrop with a gold number one balloon',
    caption: 'One year, unmistakably theirs.',
    label: 'Kids’ parties',
    ratio: 'portrait',
  },
  'corporate-brand-events': {
    image: media.actualDessertFavorCollection,
    alt: 'Four dessert favor presentations with mini cakes and decorated cake pops in blush packaging',
    caption: 'Every touchpoint considered.',
    label: 'Corporate and brand events',
    ratio: 'portrait',
    motion: {
      id: 'ivone',
      mp4: '/videos/actual/actual-ivone-event-details-v1.mp4',
      poster: '/videos/actual/actual-ivone-event-details-v1-poster.webp',
      width: 576,
      height: 768,
      description: 'a planner arranging the final details of an outdoor sweets display',
    },
  },
};

const items = await Promise.all(
  eventTypes.map(async (eventType, itemIndex) => {
    const presentation = presentations[eventType.slug] ?? {
      image: media[eventType.image],
      alt: eventType.imageAlt,
      caption: eventType.gatewayBody,
      label: eventType.title,
      ratio: 'landscape' as const,
    };
    const compactMobileCard = itemIndex === 2 || itemIndex === 3;
    const mobileWidthTargets = compactMobileCard ? [240, 360, 480, 720] : [480, 720, 960];
    const mobileWidths = mobileWidthTargets.filter((width) => width <= presentation.image.width);
    if (!mobileWidths.includes(presentation.image.width) && presentation.image.width < 960) {
      mobileWidths.push(presentation.image.width);
    }
    const mobileImages = await Promise.all(
      mobileWidths.map((width) =>
        getImage({
          src: presentation.image,
          width,
          format: 'avif',
          quality: 72,
        }),
      ),
    );
    const mobileSrcset = mobileImages
      .map((mobileImage, mobileIndex) => `${mobileImage.src} ${mobileWidths[mobileIndex]}w`)
      .join(', ');
    const mobileSizes = compactMobileCard
      ? '(max-width: 367px) calc(100vw - 2.5rem), calc((100vw - 3.35rem) / 2)'
      : 'calc(100vw - 2.5rem)';
    const responsiveSizes = compactMobileCard
      ? '(max-width: 367px) calc(100vw - 2.5rem), (max-width: 767px) calc((100vw - 3.35rem) / 2), (max-width: 1199px) 48vw, 38vw'
      : '(max-width: 767px) calc(100vw - 2.5rem), (max-width: 1199px) 48vw, 38vw';
    const posterImage =
      mobileImages[mobileWidths.indexOf(720)] ?? mobileImages.at(-1) ?? mobileImages[0];

    return {
      eventType,
      presentation,
      mobileSrcset,
      mobileSizes,
      responsiveSizes,
      videoPoster:
        presentation.motion?.id === 'dessert' ? posterImage?.src : presentation.motion?.poster,
    };
  }),
);
---

<section class="section-shell gateway-section">
  <div class="section-heading section-heading--split gateway-section__heading">
    <h2>{heading}</h2>
    <div>
      <p>{intro}</p>
      {note && <p class="gateway-section__note">{note}</p>}
    </div>
  </div>
  <div class="event-gateway" aria-label="Celebration planning options">
    {
      items.map(
        (
          { eventType, presentation, mobileSrcset, mobileSizes, responsiveSizes, videoPoster },
          index,
        ) => {
          const motion = enableMotion ? presentation.motion : undefined;

          return (
            <article
              class:list={[
                'event-gateway__item',
                `event-gateway__item--${index + 1}`,
                `event-gateway__item--${presentation.ratio}`,
              ]}
            >
              <div
                class:list={['event-gateway__media', motion && 'event-gateway__media--motion']}
                data-actual-video={motion?.id}
                data-video-description={motion?.description}
                data-video-state={motion ? 'poster' : undefined}
                role={motion ? 'button' : undefined}
                tabindex={motion ? '0' : undefined}
                aria-label={motion ? `Play motion: ${motion.description}` : undefined}
              >
                {motion ? (
                  <video
                    data-actual-video-element
                    data-src-mp4={motion.mp4}
                    poster={videoPoster}
                    width={motion.width}
                    height={motion.height}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="none"
                    disablepictureinpicture
                    disableRemotePlayback
                    aria-hidden="true"
                    tabindex="-1"
                  />
                ) : (
                  <picture>
                    <source
                      media="(max-width: 767px)"
                      type="image/avif"
                      srcset={mobileSrcset}
                      sizes={mobileSizes}
                    />
                    <Image
                      src={presentation.image}
                      alt={presentation.alt}
                      widths={[480, 720, 960, 1200]}
                      fit="cover"
                      sizes={responsiveSizes}
                      loading="lazy"
                      quality={80}
                    />
                  </picture>
                )}
                <p class="event-gateway__caption">{presentation.caption}</p>
              </div>
              <a class="event-gateway__copy" href={`/events/${eventType.slug}/`}>
                <p class="event-gateway__label">{presentation.label}</p>
                <h3>{eventType.gatewayTitle}</h3>
                <p>{eventType.gatewayBody}</p>
                <span>
                  Explore the celebration <span aria-hidden="true">→</span>
                </span>
              </a>
            </article>
          );
        },
      )
    }
  </div>
</section>

<script>
  import { initActualMediaVideos } from '@/lib/actual-media-video';

  initActualMediaVideos();
</script>
