---
import { Image } from 'astro:assets';
import { media } from '@/data/media';

const galleryItems = [
  {
    image: media.actualWeddingTablescape,
    alt: 'Wedding tables with ivory linens, floral centerpieces, gold chargers, and blue goblets',
    caption: 'Wedding Tablescapes',
  },
  {
    image: media.actualPhotoBoothStyling,
    alt: 'A photo booth and prop table beside a pink draped backdrop and floral arrangements',
    caption: 'Photo Moments',
  },
  {
    image: media.actualGuestTableSetup,
    alt: 'Guest tables with red linens, black chairs, and custom place settings',
    caption: 'Tablescape and Flow',
  },
  {
    image: media.actualMilestoneDessertTable,
    alt: 'A fiftieth birthday dessert table beneath black, gold, and silver balloons',
    caption: 'Milestone Celebrations',
  },
  {
    image: media.actualCupcakeDisplay,
    alt: 'Cupcakes topped with cherries and arranged on vintage floral tiered stands',
    caption: 'Dessert Styling',
  },
  {
    image: media.actualOutdoorPhotoBooth,
    alt: 'An outdoor photo booth beside a white table of colorful photo props',
    caption: 'Guest Experiences',
  },
] as const;

const galleryWidths = [320, 480, 640, 800, 1040, 1280, 1600];
---

<section class="actual-work section-shell" aria-labelledby="actual-work-title">
  <div class="section-heading section-heading--split actual-work__heading" data-site-reveal>
    <div>
      <p class="eyebrow">Selected Work</p>
      <h2 id="actual-work-title">Every Detail Earns Its Place.</h2>
    </div>
    <p>
      The room, the welcome, the service, the final flourish. Each element is considered on its own
      and composed as part of something larger.
    </p>
  </div>
  <div class="actual-work__grid">
    {
      galleryItems.map((item, index) => (
        <figure class:list={['actual-work__item', `actual-work__item--${index + 1}`]}>
          <Image
            src={item.image}
            alt={item.alt}
            widths={galleryWidths.filter((width) => width <= item.image.width)}
            sizes={
              index === 0 || index === 3
                ? '(max-width: 767px) calc(100vw - 2.5rem), 60vw'
                : '(max-width: 767px) calc((100vw - 3.15rem) / 2), 38vw'
            }
            loading="lazy"
            quality={78}
          />
          <figcaption>{item.caption}</figcaption>
        </figure>
      ))
    }
  </div>
</section>
