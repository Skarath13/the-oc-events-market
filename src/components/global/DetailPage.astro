---
import PageHero from './PageHero.astro';
import FaqList from './FaqList.astro';
import FinalCta from './FinalCta.astro';
import SectionTransition from './SectionTransition.astro';
import { eventTypes } from '@/data/eventTypes';
import type { ServicePage } from '@/data/services';
import type { EventTypePage } from '@/data/eventTypes';
import { media } from '@/data/media';

type Props = {
  page: ServicePage | EventTypePage;
  kind: 'service' | 'event';
};

const { page, kind } = Astro.props;
const forItems = 'forWhom' in page ? page.forWhom : [page.whoFor];
const relatedEvents = eventTypes.filter((eventType) => eventType.slug !== page.slug).slice(0, 3);
---

<PageHero
  title={page.h1}
  summary={page.summary}
  image={media[page.image]}
  imageAlt={page.imageAlt}
  imageFit={'imageFit' in page ? page.imageFit : 'cover'}
  proof="One creative direction. One current plan. One accountable planner."
/>

<section class="section-shell detail-overview">
  <div class="detail-overview__fit" data-site-reveal>
    <p class="eyebrow">Designed for</p>
    <h2>A smart fit if…</h2>
    <div class="detail-overview__fit-copy">
      {forItems.map((item) => <p>{item}</p>)}
    </div>
  </div>
  <div class="detail-overview__scope">
    <div class="detail-overview__scope-heading" data-site-reveal>
      <div>
        <p class="eyebrow">Inside the plan</p>
        <h2>What we can bring together</h2>
      </div>
      <p>Your proposal makes every deliverable, approval, and vendor role unmistakably clear.</p>
    </div>
    <div class="detail-list detail-list--grid">
      {
        page.capabilities.map((capability) => (
          <article class="detail-list__item">
            <h3>{capability.title}</h3>
            <p>{capability.body}</p>
          </article>
        ))
      }
    </div>
  </div>
  <p class="narrative-bridge detail-overview__bridge" data-site-reveal>
    Once the scope is clear, every partner can move through one current plan.
  </p>
</section>

<section class="section-shell detail-vendor">
  <aside class="vendor-brief" data-site-reveal>
    <p class="eyebrow">Your team, beautifully coordinated</p>
    <h3>Bring your favorites. We’ll bring the plan.</h3>
    <p>
      Keep the creative partners you already trust or ask us to source the missing pieces. Your
      planner keeps every relationship, deadline, and dependency moving in the same direction.
    </p>
    <p class="vendor-brief__rule">Your people. Our recommendations. One beautifully run event.</p>
    <a class="text-link text-link--light" href="/trusted-creative-network/"
      >How vendor coordination works</a
    >
  </aside>
</section>

<SectionTransition from="porcelain" to="white" shape="rise" />
<section class="detail-answers surface-white">
  <div class="section-shell">
    <div class="section-heading section-heading--split" data-site-reveal>
      <h2>The details that make it work</h2>
      <p>
        The polish comes from decisions guests never see. We surface them early, assign them
        clearly, and keep them moving.
      </p>
    </div>
    <div class="detail-answers__grid">
      <div class="consideration-list">
        <h3>What deserves attention</h3>
        {
          page.considerations.map((consideration) => (
            <article>
              <h4>{consideration.title}</h4>
              <p>{consideration.body}</p>
            </article>
          ))
        }
      </div>
      <div class="detail-answers__faqs">
        <h3>Straight answers</h3>
        <FaqList faqs={page.faqs} />
      </div>
    </div>
  </div>
</section>

<SectionTransition from="white" to="porcelain" shape="drift-left" />
<section class="section-shell related-strip">
  <div class="related-strip__heading" data-site-reveal>
    <div>
      <p class="eyebrow">Back to the occasion</p>
      <h2>See what else we plan</h2>
    </div>
    <div>
      <p>
        {
          kind === 'service'
            ? 'The creative and operational priorities shift with every kind of gathering.'
            : 'Explore another celebration or see how planning support can meet you where you are.'
        }
      </p>
      <p>
        <a class="text-link" href="/services/">Planning services</a>
      </p>
    </div>
  </div>
  <div class="related-strip__list">
    {
      relatedEvents.map((eventType) => (
        <a class="related-strip__item" href={`/events/${eventType.slug}/`}>
          <h3>{eventType.title}</h3>
          <p>{eventType.gatewayBody}</p>
        </a>
      ))
    }
  </div>
</section>

<FinalCta />
