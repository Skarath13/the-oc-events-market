---
import PageHero from './PageHero.astro';
import FaqList from './FaqList.astro';
import FinalCta from './FinalCta.astro';
import { processSteps } from '@/data/site';
import { eventTypes } from '@/data/eventTypes';
import type { ServicePage } from '@/data/services';
import type { EventTypePage } from '@/data/eventTypes';
import { media } from '@/data/media';

type Props = {
  page: ServicePage | EventTypePage;
  kind: 'service' | 'event';
};

const { page, kind } = Astro.props;
const forItems = 'forWhom' in page ? page.forWhom : [page.whoFor];
const relatedEvents = eventTypes.filter((eventType) => eventType.slug !== page.slug).slice(0, 3);
---

<PageHero
  title={page.h1}
  summary={page.summary}
  image={media[page.image]}
  imageAlt={page.imageAlt}
  proof="Your planner brings every vendor into one plan"
/>

<section class="section-shell detail-intro">
  <div>
    <h2>Who this planning is for</h2>
  </div>
  <div class="detail-intro__body">
    {forItems.map((item) => <p>{item}</p>)}
  </div>
</section>

<section class="section-shell section-shell--tight surface-white">
  <div class="section-heading section-heading--split">
    <h2>What the planning can handle</h2>
    <p>
      Responsibilities are confirmed in the selected service. The proposal defines exactly what we
      manage, not a broad label on the website.
    </p>
  </div>
  <div class="detail-list">
    {
      page.capabilities.map((capability) => (
        <article class="detail-list__item">
          <h3>{capability.title}</h3>
          <p>{capability.body}</p>
        </article>
      ))
    }
  </div>
</section>

<section class="section-shell process-section">
  <div class="section-heading">
    <h2>A clear planning rhythm</h2>
    <p>
      We move the work from priorities to decisions, then bring every vendor and detail for the
      event day into one approved plan.
    </p>
  </div>
  <ol class="process-rail">
    {
      processSteps.map((step, index) => (
        <li class="process-rail__step">
          <span class="process-rail__number" aria-hidden="true">
            0{index + 1}
          </span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<section class="section-shell vendor-flex">
  <div>
    <h2>Your planner, whichever vendors you choose.</h2>
    <p>
      We can recommend the right professionals when sourcing is included or coordinate the vendors
      you have already chosen. Either way, your planner keeps the relationship, timeline, and shared
      direction connected.
    </p>
    <a class="text-link" href="/trusted-creative-network/">How vendor coordination works</a>
  </div>
  <p class="vendor-flex__rule">Your vendors or trusted recommendations. A coordinated plan.</p>
</section>

<section class="considerations">
  <div class="section-shell">
    <div class="section-heading">
      <h2>Planning considerations that matter here</h2>
    </div>
    <div class="considerations-grid">
      {
        page.considerations.map((consideration) => (
          <article>
            <h3>{consideration.title}</h3>
            <p>{consideration.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section-shell">
  <div class="section-heading section-heading--split">
    <h2>Questions, answered plainly</h2>
    <p>
      These answers avoid assumptions about packages. Your proposal should settle every
      responsibility for your event before work begins.
    </p>
  </div>
  <FaqList faqs={page.faqs} />
</section>

<section class="section-shell section-shell--tight">
  <div class="section-heading section-heading--split">
    <h2>Keep exploring</h2>
    <div>
      <p>
        {
          kind === 'service'
            ? 'See how planning changes across different celebrations.'
            : 'Compare other event types or review the planning process.'
        }
      </p>
      <p>
        <a class="text-link" href="/services/">Planning services</a>
        {' or '}
        <a class="text-link" href="/process/">The process</a>
      </p>
    </div>
  </div>
  <div class="detail-list">
    {
      relatedEvents.map((eventType) => (
        <a class="detail-list__item" href={`/events/${eventType.slug}/`}>
          <h3>{eventType.title}</h3>
          <p>{eventType.gatewayBody}</p>
        </a>
      ))
    }
  </div>
</section>

<FinalCta />
