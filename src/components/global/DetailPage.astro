---
import PageHero from './PageHero.astro';
import FaqList from './FaqList.astro';
import FinalCta from './FinalCta.astro';
import { eventTypes } from '@/data/eventTypes';
import type { ServicePage } from '@/data/services';
import type { EventTypePage } from '@/data/eventTypes';
import { media } from '@/data/media';

type Props = {
  page: ServicePage | EventTypePage;
  kind: 'service' | 'event';
};

const { page, kind } = Astro.props;
const forItems = 'forWhom' in page ? page.forWhom : [page.whoFor];
const relatedEvents = eventTypes.filter((eventType) => eventType.slug !== page.slug).slice(0, 3);
---

<PageHero
  title={page.h1}
  summary={page.summary}
  image={media[page.image]}
  imageAlt={page.imageAlt}
  proof="Your planner brings every vendor into one plan"
/>

<section class="section-shell detail-overview">
  <div class="detail-overview__fit">
    <p class="eyebrow">Best fit</p>
    <h2>Is this the right fit?</h2>
    <div class="detail-overview__fit-copy">
      {forItems.map((item) => <p>{item}</p>)}
    </div>
  </div>
  <div class="detail-overview__scope">
    <div class="detail-overview__scope-heading">
      <div>
        <p class="eyebrow">Possible scope</p>
        <h2>What your plan can cover</h2>
      </div>
      <p>Your proposal confirms what we manage, what you approve, and what each vendor handles.</p>
    </div>
    <div class="detail-list detail-list--grid">
      {
        page.capabilities.map((capability) => (
          <article class="detail-list__item">
            <h3>{capability.title}</h3>
            <p>{capability.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section-shell detail-vendor">
  <aside class="vendor-brief">
    <p class="eyebrow">Vendor flexibility</p>
    <h3>Bring your vendors or ask us to find them.</h3>
    <p>
      When sourcing is included, we can recommend professionals. We can also coordinate vendors you
      have already chosen. Either way, your planner keeps the relationships, timeline, and direction
      connected.
    </p>
    <p class="vendor-brief__rule">Your vendors. Trusted recommendations. One coordinated plan.</p>
    <a class="text-link text-link--light" href="/trusted-creative-network/"
      >How vendor coordination works</a
    >
  </aside>
</section>

<section class="detail-answers surface-white">
  <div class="section-shell">
    <div class="section-heading section-heading--split">
      <h2>Important details and clear answers</h2>
      <p>
        These points help shape the plan. Your proposal settles every responsibility before work
        begins.
      </p>
    </div>
    <div class="detail-answers__grid">
      <div class="consideration-list">
        <h3>What matters here</h3>
        {
          page.considerations.map((consideration) => (
            <article>
              <h4>{consideration.title}</h4>
              <p>{consideration.body}</p>
            </article>
          ))
        }
      </div>
      <div class="detail-answers__faqs">
        <h3>Questions, answered plainly</h3>
        <FaqList faqs={page.faqs} />
      </div>
    </div>
  </div>
</section>

<section class="section-shell related-strip">
  <div class="related-strip__heading">
    <div>
      <p class="eyebrow">Keep exploring</p>
      <h2>Compare another path</h2>
    </div>
    <div>
      <p>
        {
          kind === 'service'
            ? 'See how planning changes across different celebrations.'
            : 'Compare other event types or explore planning services.'
        }
      </p>
      <p>
        <a class="text-link" href="/services/">Planning services</a>
      </p>
    </div>
  </div>
  <div class="related-strip__list">
    {
      relatedEvents.map((eventType) => (
        <a class="related-strip__item" href={`/events/${eventType.slug}/`}>
          <h3>{eventType.title}</h3>
          <p>{eventType.gatewayBody}</p>
        </a>
      ))
    }
  </div>
</section>

<FinalCta />
