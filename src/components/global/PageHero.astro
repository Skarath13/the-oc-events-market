---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  title: string;
  summary?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageFit?: 'cover' | 'contain';
  proof?: string;
};

const { title, summary, image, imageAlt = '', imageFit = 'cover', proof } = Astro.props;
const imageOrientation = image && image.width >= image.height ? 'landscape' : 'portrait';
const mobileWidths = image
  ? [
      ...new Set([
        ...[480, 720, 736, 960].filter((width) => width <= image.width),
        ...(image.width < 960 ? [image.width] : []),
      ]),
    ].sort((a, b) => a - b)
  : [];
const mobileImages = image
  ? await Promise.all(
      mobileWidths.map((width) =>
        getImage({
          src: image,
          width,
          height: imageFit === 'cover' ? Math.round((width * 9) / 16) : undefined,
          fit: imageFit,
          format: 'avif',
          quality: 72,
        }),
      ),
    )
  : [];
const mobileSrcset = mobileImages
  .map((mobileImage, index) => `${mobileImage.src} ${mobileWidths[index]}w`)
  .join(', ');
---

<section
  class:list={[
    'page-hero',
    image && `page-hero--${imageFit}`,
    image && `page-hero--${imageOrientation}`,
  ]}
>
  <div class="page-hero__copy" data-site-hero>
    <h1>{title}</h1>
    {summary && <p class="page-hero__summary">{summary}</p>}
    {proof && <p class="page-hero__proof">{proof}</p>}
  </div>
  {
    image && (
      <div
        class:list={[
          'page-hero__media',
          `page-hero__media--${imageFit}`,
          `page-hero__media--${imageOrientation}`,
        ]}
      >
        <picture>
          <source
            media="(max-width: 767px)"
            type="image/avif"
            srcset={mobileSrcset}
            sizes="100vw"
          />
          <Image
            src={image}
            alt={imageAlt}
            widths={[720, 960, 1280]}
            fit={imageFit}
            sizes={
              imageFit === 'contain'
                ? '(max-width: 767px) 100vw, 50vw'
                : '(max-width: 767px) 100vw, 45vw'
            }
            loading="eager"
            fetchpriority="high"
            quality={78}
          />
        </picture>
      </div>
    )
  }
  <div class="page-hero__transition" aria-hidden="true"></div>
</section>
