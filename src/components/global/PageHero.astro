---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  title: string;
  summary: string;
  image?: ImageMetadata;
  imageAlt?: string;
  proof?: string;
};

const { title, summary, image, imageAlt = '', proof } = Astro.props;
const mobileImage = image
  ? await getImage({ src: image, width: 480, format: 'avif', quality: 68 })
  : null;
---

<section class="page-hero">
  <div class="page-hero__copy">
    <h1>{title}</h1>
    <p class="page-hero__summary">{summary}</p>
    {proof && <p class="page-hero__proof">{proof}</p>}
  </div>
  {
    image && (
      <div class="page-hero__media">
        <picture>
          <source media="(max-width: 767px)" type="image/avif" srcset={mobileImage?.src} />
          <Image
            src={image}
            alt={imageAlt}
            widths={[720, 960, 1280]}
            sizes="(max-width: 767px) 100vw, 45vw"
            loading="eager"
            fetchpriority="high"
            quality={78}
          />
        </picture>
      </div>
    )
  }
</section>
