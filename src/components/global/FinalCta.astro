---
import { contactLinks } from '@/data/site';

type Props = {
  heading?: string;
  body?: string;
  label?: string;
  href?: string;
};

const {
  heading = 'Tell us what you’re celebrating.',
  body = 'Share the occasion, planning window, and where you need support. We’ll help you shape the rest.',
  label = 'Check Availability',
  href = '/contact/',
} = Astro.props;
---

<section class="final-cta">
  <div class="final-cta__inner">
    <div>
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <div class="final-cta__actions">
      <a class="button button--dark" href={href}>{label}</a>
      <a
        class="button button--outline"
        href={contactLinks.inquiryText}
        data-analytics-event="text_cta_click"
        data-analytics-context="final_cta">Text Event Details</a
      >
    </div>
  </div>
</section>
