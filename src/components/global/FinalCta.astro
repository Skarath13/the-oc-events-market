---
import { contactLinks } from '@/data/site';

type Props = {
  heading?: string;
  body?: string;
  label?: string;
  href?: string;
};

const {
  heading = 'Let’s make it one they talk about.',
  body = 'Send the occasion, date, and what is already taking shape. We’ll turn the loose ends into a clear next move.',
  label = 'Start Planning',
  href = '/contact/',
} = Astro.props;
---

<section class="final-cta">
  <div class="final-cta__inner">
    <div>
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <div class="final-cta__actions">
      <a class="button button--dark" href={href}>{label}</a>
      <a
        class="button button--outline"
        href={contactLinks.inquiryText}
        data-analytics-event="text_cta_click"
        data-analytics-context="final_cta">Text Event Details</a
      >
    </div>
  </div>
</section>
