---
import {
  IconAccessible,
  IconBriefcase,
  IconCalendarEvent,
  IconChecklist,
  IconConfetti,
  IconFileDescription,
  IconMail,
  IconMessage,
  IconShieldLock,
  IconUser,
  IconUsersGroup,
} from '@tabler/icons-astro';
import { footerNavigation, primaryNavigation } from '@/data/navigation';
import { contactLinks, featureFlags, siteConfig } from '@/data/site';

const primaryNavigationIcons = {
  '/services/': IconChecklist,
  '/celebrations/': IconConfetti,
  '/about/': IconUser,
  '/journal/': IconFileDescription,
  '/contact/': IconMessage,
} as const;

const footerNavigationIcons = {
  '/trusted-creative-network/': IconUsersGroup,
  '/for-vendors/': IconBriefcase,
  '/privacy/': IconShieldLock,
  '/terms/': IconFileDescription,
  '/accessibility/': IconAccessible,
} as const;
---

<aside class="verse-banner" aria-label="Bible verse reference">
  <p>Romans 10:9</p>
</aside>

<footer class="site-footer">
  <div class="site-footer__top">
    <div class="brand-lockup brand-lockup--footer">
      <span class="brand-lockup__name">{siteConfig.businessName}</span>
      <span class="brand-lockup__descriptor">{siteConfig.descriptor}</span>
    </div>
    <p class="site-footer__promise">{siteConfig.brandPromise}</p>
  </div>
  <div class="site-footer__grid">
    <div>
      <h2 class="site-footer__heading">Plan a celebration</h2>
      <p>
        Distinct creative direction, calm execution, and one planner keeping every moving piece in
        sync.
      </p>
      <a class="text-link text-link--light site-footer__link" href="/contact/">
        <IconCalendarEvent aria-hidden="true" size={17} stroke={1.6} />
        <span>Check availability</span>
      </a>
    </div>
    <nav aria-label="Footer client links">
      <h2 class="site-footer__heading">Explore</h2>
      <ul>
        {
          primaryNavigation.map((item) => {
            const Icon = primaryNavigationIcons[item.href as keyof typeof primaryNavigationIcons];

            return (
              <li>
                <a class="site-footer__link" href={item.href}>
                  <Icon aria-hidden="true" size={16} stroke={1.6} />
                  <span>{item.label}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <nav aria-label="Footer business and legal links">
      <h2 class="site-footer__heading">More</h2>
      <ul>
        {
          footerNavigation.map((item) => {
            const Icon = footerNavigationIcons[item.href];

            return (
              <li>
                <a class="site-footer__link" href={item.href}>
                  <Icon aria-hidden="true" size={16} stroke={1.6} />
                  <span>{item.label}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <div>
      <h2 class="site-footer__heading">Service area</h2>
      <p>{siteConfig.serviceArea}</p>
      {
        featureFlags.showPhone && siteConfig.publicPhone && (
          <>
            <p class="site-footer__phone">{siteConfig.publicPhoneDisplay}</p>
            <p>
              <a
                class="site-footer__contact-link site-footer__link"
                href={contactLinks.inquiryText}
                data-analytics-event="text_cta_click"
                data-analytics-context="footer"
              >
                <IconMessage aria-hidden="true" size={16} stroke={1.6} />
                <span>Text event details</span>
              </a>
            </p>
          </>
        )
      }
      {
        siteConfig.publicEmail && (
          <p>
            <a class="site-footer__link" href={`mailto:${siteConfig.publicEmail}`}>
              <IconMail aria-hidden="true" size={16} stroke={1.6} />
              <span>{siteConfig.publicEmail}</span>
            </a>
          </p>
        )
      }
    </div>
  </div>
  <div class="site-footer__bottom">
    <p>© {new Date().getFullYear()} {siteConfig.businessName}</p>
    <p>Event Planning and Design in Orange County, California</p>
  </div>
</footer>
