---
import type { Faq } from '@/data/services';

type Props = {
  faqs: readonly Faq[];
};

const { faqs } = Astro.props;
---

<div class="faq-list">
  {
    faqs.map((faq) => (
      <details>
        <summary>{faq.question}</summary>
        <div class="faq-list__answer">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))
  }
</div>
