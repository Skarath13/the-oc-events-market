{
  "name": "the-oc-events-market",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:forms": "playwright test --grep @forms",
    "lighthouse": "PUBLIC_SITE_URL=https://events.test PUBLIC_SITE_INDEXABLE=true pnpm build && lhci autorun",
    "links": "linkinator dist/client --recurse --check-css --check-fragments --skip 'events\\.test|the-oc-events-market\\.example|/api/|mailto:|tel:'",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm build && pnpm test:e2e",
    "assets:download": "node scripts/download-images.mjs",
    "assets:inspect": "node scripts/create-contact-sheet.mjs",
    "pages:prepare": "node scripts/prepare-pages-preview.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.1.3",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "linkinator": "8.0.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
