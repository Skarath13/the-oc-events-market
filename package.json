{
  "name": "the-oc-events-market",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/prepare-worker-deploy.mjs",
    "build:cloudflare": "PUBLIC_SITE_URL=https://theoceventsmarket.com PUBLIC_SITE_INDEXABLE=true astro build && node scripts/prepare-worker-deploy.mjs",
    "preview": "pnpm run build:cloudflare && wrangler dev",
    "start": "wrangler dev",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:contact": "playwright test --grep @contact",
    "test:hero": "playwright test tests/e2e/hero-video.spec.ts",
    "lighthouse": "CLOUDFLARE_ENV=lighthouse PUBLIC_SITE_URL=https://events.test PUBLIC_SITE_INDEXABLE=true pnpm build && lhci autorun",
    "links": "linkinator dist --recurse --check-css --check-fragments --skip 'events\\.test|the-oc-events-market\\.example|theoceventsmarket\\.com|mailto:|sms:'",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm run verify:hero-media && pnpm build && pnpm test:e2e",
    "assets:download": "node scripts/download-images.mjs",
    "assets:inspect": "node scripts/create-contact-sheet.mjs",
    "generate-types": "wrangler types --include-runtime false --strict-vars false",
    "verify:hero-media": "node scripts/verify-hero-media.mjs",
    "verify:cloudflare-scope": "node scripts/verify-cloudflare-scope.mjs",
    "verify:cloudflare": "pnpm run verify:cloudflare-scope && pnpm run build:cloudflare && wrangler deploy --dry-run",
    "deploy": "pnpm run verify:cloudflare && CLOUDFLARE_ACCOUNT_ID=23f44eec8348248aa186c7511ed36e07 wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.6",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.1.3",
    "qrcode": "1.5.4",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.0",
    "@types/qrcode": "1.5.6",
    "@types/node": "26.1.1",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "linkinator": "8.0.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "wrangler": "^4.115.0"
  }
}
